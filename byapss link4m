// @grant        GM_xmlhttpRequest
// @grant        GM.xmlHttpRequest
// @grant        GM_setValue
// @grant        GM.setValue
// @grant        GM_getValue
// @grant        GM.getValue
// @grant        GM_deleteValue
// @grant        GM.deleteValue
// @grant        unsafeWindow
// ==/UserScript==

(function() {
    'use strict';

    // Polyfill: Ép Stay iOS hiểu các lệnh GM_ cũ bằng chuẩn GM. mới
    const w = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;

    if (typeof GM !== 'undefined') {
        if (typeof w.GM_xmlhttpRequest === 'undefined' && GM.xmlHttpRequest) {
            w.GM_xmlhttpRequest = GM.xmlHttpRequest;
        }
        if (typeof w.GM_setValue === 'undefined' && GM.setValue) {
            w.GM_setValue = GM.setValue;
        }
        if (typeof w.GM_getValue === 'undefined' && GM.getValue) {
            w.GM_getValue = GM.getValue;
        }
        if (typeof w.GM_deleteValue === 'undefined' && GM.deleteValue) {
            w.GM_deleteValue = GM.deleteValue;
        }
    }
})();

